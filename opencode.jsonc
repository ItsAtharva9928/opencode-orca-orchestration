{
  "$schema": "https://opencode.ai",
  "instructions": ["~/.config/opencode/ORCHESTRATION.md"],
  "model": "openai/gpt-5.6-sol",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "*rm -rf *": "deny",
      "*rm -r *": "deny",
      "*rmdir *": "deny",
      "*git reset --hard*": "deny",
      "*git clean -f*": "deny",
      "*git push *--force*": "deny",
      "*git push *-f *": "deny",
      "*git push *-f": "deny",
      "*mkfs*": "deny",
      "*dd if=*": "deny",
      "*format *": "deny",
      "*:(){ :|:& };:*": "deny"
    }
  },
  "agent": {
    "build": {
      "variant": "medium"
    },
    "plan": {},
    "general": {},
    "explore": {
      "model": "google/antigravity-gemini-3.7-flash",
      "variant": "medium"
    },
    "compaction": {},
    "title": {},
    "summary": {}
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "store": false
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (Lead Orchestrator)",
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto" },
            "medium": { "reasoningEffort": "medium", "reasoningSummary": "auto" },
            "high": { "reasoningEffort": "high", "reasoningSummary": "detailed" }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (Fast Worker)",
          "variants": {
            "low": { "reasoningEffort": "low", "reasoningSummary": "auto" }
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "models": {
        "google/antigravity-gemini-3.8-flash": { "name": "Gemini 3.8 Flash" },
        "google/antigravity-gemini-3.7-flash": { "name": "Gemini 3.7 Flash" }
      }
    }
  },
  "plugin": [
    "opencode-openai-codex-auth",
    "@cortexkit/opencode-antigravity-auth@latest"
  ]
}
